{
  "name": "veyra",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "build:runtime": "node scripts/build.mjs",
    "build:core": "cargo build --release",
    "desktop": "cargo build --release && node scripts/build-desktop.mjs && npm run build:runtime && electron apps/desktop/main.js",
    "render": "cargo run --release -q -p veyra-cli -- render",
    "test": "cargo test && node --test tests/core.test.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  }
}